[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "{{ project_version }}"
description = "{{ description }}"
readme = "README.md"
license = { text = "MIT" }
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">=3.13"
keywords = []
classifiers = [
  "Development Status :: 3 - Alpha",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3.13",
]
dependencies = [
{% for dep in runtime_dependencies %}
  "{{ dep }}",
{% endfor %}
]

[project.urls]
Homepage = "https://github.com/{{ github_username }}/{{ project_name }}"
Repository = "https://github.com/{{ github_username }}/{{ project_name }}"
Issues = "https://github.com/{{ github_username }}/{{ project_name }}/issues"

[tool.hatch.env]
installer = "uv"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.hatch.envs.default]
dependencies = [
  "pytest>=8.0",
  "pytest-cov>=5.0",
  "pytest-qt>=4.4",
  "PySide6>=6.10.2",
  "qbittorrent-api>=2025.11.1",
]

[tool.hatch.envs.default.scripts]
test = "pytest {args:tests}"
test-cov = "pytest --cov=src/{{ package_name }} --cov-report=term-missing --cov-report=xml {args:tests}"

[tool.hatch.envs.lint]
dependencies = [
  "ruff>=0.6",
  "basedpyright>=1.18",
]

[tool.hatch.envs.lint.scripts]
check = "ruff check ."
fmt = "ruff format --check ."
fix = ["ruff check --fix .", "ruff format ."]
types = "basedpyright src/{{ package_name }}"
policy = "python scripts/policy/check_standard.py"
all = [
  "ruff check --fix .",
  "ruff format .",
  "basedpyright src/{{ package_name }}",
  "python scripts/policy/check_standard.py",
]

[tool.hatch.envs.test]
dependencies = [
  "pytest>=8.0",
  "pytest-cov>=5.0",
  "pytest-qt>=4.4",
  "PySide6>=6.10.2",
  "qbittorrent-api>=2025.11.1",
]

[[tool.hatch.envs.test.matrix]]
python = ["3.13"]

[tool.hatch.envs.test.scripts]
run = "pytest {args:tests}"

[tool.ruff]
target-version = "py313"
line-length = 88
src = ["src"]

[tool.ruff.lint]
select = [
  "E",
  "W",
  "F",
  "I",
  "N",
  "B",
  "C4",
  "UP",
  "SIM",
  "TCH",
  "RUF",
]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**/*" = ["S101", "S105", "S106"]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
docstring-code-format = true

[tool.basedpyright]
pythonVersion = "3.13"
pythonPlatform = "All"
typeCheckingMode = "strict"
venvPath = "."
venv = ".venv"
include = ["src"]
exclude = ["tests", "**/__pycache__"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers", "--import-mode=importlib"]
xfail_strict = true

[tool.coverage.run]
source = ["src/{{ package_name }}"]
branch = true
omit = ["tests/*"]

[tool.coverage.report]
fail_under = 80
show_missing = true
skip_covered = false
